# 数据库（T-008 起使用；T-007 可不连库）
# PaaS（Railway/Render）可直接填 postgresql://…，启动时会归一成 +asyncpg
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/journal_growth

# 服务
HOST=127.0.0.1
PORT=8099
DEBUG=true
APP_NAME=journal-growth

# CORS（Agent 5199 + 用户门禁 5175；生产填公开 HTTPS origin 的 JSON 数组）
CORS_ORIGINS=["http://localhost:5199","http://127.0.0.1:5199","http://localhost:5175","http://127.0.0.1:5175"]

# JWT（请在 backend/.env 填写真实随机值，勿提交仓库）
JWT_SECRET=change-me-to-a-long-random-secret

# LLM（可空；缺失时 AI 任务走 Mock）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# 邮件（开发期 / 个人 PaaS：打印验证链接到日志）
MAIL_DEV_PRINT=true

# 验证链接拼进此前端 origin（开发默认 Agent 端口；生产填公开 URL）
FRONTEND_PUBLIC_URL=http://127.0.0.1:5199

# 导入上传目录（相对项目根或绝对路径）
UPLOAD_DIR=backend/data/uploads

# PaaS 同域托管前端时设置（Docker 镜像默认 /app/frontend/dist；本地可空）
STATIC_DIR=
